# ── URJ Portal · backend configuration ──
# PostgreSQL (default). Use the docker-compose DB or a local Postgres.
DATABASE_URL=postgresql+psycopg://urj:urj@localhost:5432/urj_portal

# To run instantly with zero setup, use SQLite instead (comment the line above):
# DATABASE_URL=sqlite:///./urj_portal.db

# CORS — the Vite dev server origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
